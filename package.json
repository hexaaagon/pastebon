    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0"
  },
  "optionalDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "prettier-plugin-java": "^2.7.5"
  },
  "packageManager": "pnpm@9.15.0",
  "overrides": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2"
  },
  "pnpm": {
    "overrides": {
      "@fumari/json-schema-to-typescript>prettier": "$prettier"
    }
  }
}
