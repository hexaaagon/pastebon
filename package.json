{
  "name": "pastebon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:docs && pnpm run build:next",
    "build:next": "next build",
    "build:docs": "node scripts/generate-docs.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -r dotenv/config src/lib/db/migrate.ts",
    "db:drop": "drizzle-kit drop",
    "db:pull": "drizzle-kit introspect",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^10.2.0",
    "@monaco-editor/react": "4.7.0-rc.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scalar/api-client-react": "^1.3.45",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.74.0",
    "@types/fs-extra": "^11.0.4",
    "@vercel/functions": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.6.1",
    "easy-peasy": "^6.1.0",
    "fs-extra": "^11.3.2",
    "fumadocs-core": "^14.7.7",
    "fumadocs-mdx": "^11.10.1",
    "fumadocs-openapi": "^5.12.0",
    "fumadocs-ui": "^14.7.7",
    "glob": "^11.0.3",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.1.6",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "prettier": "^3.6.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "^6.0.1",
    "sonner": "^1.7.4",
    "swr": "^2.3.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsc-alias": "^1.8.16",
    "zod": "^4.1.12",
    "zod-form-data": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.19.19",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.1.1",
